      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "party": {
          "title": "Party",
          "type": "string"
        },
        "incumbent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incumbent"
        },
        "fec_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fec Id"
        }
      },
      "required": [
        "id",
        "name",
        "party"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "acquisition_id": {
          "title": "Acquisition Id",
          "type": "string"
        },
        "race_id": {
          "title": "Race Id",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "kind": {
          "enum": [
            "fundamental",
            "poll",
            "candidate_statement",
            "local_reporting",
            "focus_group"
