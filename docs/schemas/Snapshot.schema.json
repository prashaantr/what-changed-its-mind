    "id": {
      "title": "Id",
      "type": "string"
    },
    "cutoff": {
      "format": "date-time",
      "title": "Cutoff",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
