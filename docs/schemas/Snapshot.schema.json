        "boundary_version": {
          "title": "Boundary Version",
          "type": "string"
        },
        "geography_verified": {
          "default": false,
          "title": "Geography Verified",
          "type": "boolean"
        },
        "roster_verified": {
          "default": false,
          "title": "Roster Verified",
          "type": "boolean"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "rating": {
          "anyOf": [
            {
              "enum": [
                "Toss-up",
                "Lean D",
                "Lean R",
                "Lean I",
                "Likely D",
                "Likely R"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "rating_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating Source Id"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "selection_reason": {
          "default": "Awaiting source audit",
          "title": "Selection Reason",
          "type": "string"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
