          "type": "integer"
        },
        "office": {
          "enum": [
            "house",
            "senate"
          ],
          "title": "Office",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "state_fips": {
          "title": "State Fips",
          "type": "string"
